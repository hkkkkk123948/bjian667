  "speed_factor": 1.0,
  "voice_playback_speed": 1.2,
  "sentence_timings": [
    {
      "index": 1,
      "text": "这三个女孩，被一个白发怪人盯上了。",
      "role": "hook",
      "start": 0.0,
      "end": 2.6981026681593434
    },
    {
      "index": 2,
      "text": "她们赶紧往后巷跑，躲到了垃圾箱后面。",
      "role": "context",
      "start": 2.6981026681593434,
      "end": 5.32020244425786
    },
    {
      "index": 3,
      "text": "女孩以为安全了，旁边的铁门却慢慢开了。",
      "role": "escalation",
      "start": 5.32020244425786,
      "end": 6.8022588394439785
    },
    {
      "index": 4,
      "text": "一只满是尖指甲的手，从门缝里伸了进来。",
      "role": "escalation",
      "start": 6.8022588394439785,
      "end": 9.386357169512083
    },
    {
      "index": 5,
      "text": "紧接着怪人探出了头，吓得她们再次逃跑。",
      "role": "escalation",
      "start": 9.386357169512083,
      "end": 12.274467067823492
    },
    {
      "index": 6,
      "text": "她们逃进仓库，可那个怪人又追到了门外。",
      "role": "context",
      "start": 12.274467067823492,
      "end": 13.906629174829742
    },
    {
      "index": 7,
      "text": "女孩正不知道怎么办，一个男人推门走了进来。",
      "role": "payoff",
      "start": 13.906629174829742,
      "end": 16.90874341123239
    },
    {
      "index": 8,
      "text": "他救出女孩们，警察接着来问黑发女孩情况。",
      "role": "payoff",
      "start": 16.90874341123239,
      "end": 20.366875
    }
  ],
