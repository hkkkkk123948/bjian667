  "speed_factor": 1.0,
  "sentence_timings": [
    {
      "index": 1,
      "text": "白发怪人，盯上了三个女孩。",
      "role": "hook",
      "start": 0.0,
      "end": 1.73
    },
    {
      "index": 2,
      "text": "她们拔腿就跑，一路逃进了后巷。",
      "role": "context",
      "start": 1.73,
      "end": 4.1
    },
    {
      "index": 3,
      "text": "三个女孩刚躲到垃圾箱旁。",
      "role": "context",
      "start": 4.1,
      "end": 6.59
    },
    {
      "index": 4,
      "text": "铁门就开了，尖指甲扒住了门缝。",
      "role": "escalation",
      "start": 6.59,
      "end": 9.12
    },
    {
      "index": 5,
      "text": "下一秒，那张怪脸也探了出来。",
      "role": "escalation",
      "start": 9.12,
      "end": 11.33
    },
    {
      "index": 6,
      "text": "她们逃进仓库，死死盯着那扇透光的门。",
      "role": "context",
      "start": 11.33,
      "end": 13.94
    },
    {
      "index": 7,
      "text": "她隔着门上的玻璃，想看看外面。",
      "role": "context",
      "start": 13.94,
      "end": 16.51
    },
    {
      "index": 8,
      "text": "怪人的脸，却又贴到了她眼前。",
      "role": "twist",
      "start": 16.51,
      "end": 18.88
    },
    {
      "index": 9,
      "text": "正当她们退无可退，一个男人推门进来了。",
      "role": "payoff",
      "start": 18.88,
      "end": 22.05
    },
    {
      "index": 10,
      "text": "男人救出了她们，警察也很快赶到。",
      "role": "payoff",
      "start": 22.05,
      "end": 24.7
    },
    {
      "index": 11,
      "text": "可女孩回头时，门外又闪过那双白眼。",
      "role": "payoff",
      "start": 24.7,
      "end": 27.75
    }
  ],
