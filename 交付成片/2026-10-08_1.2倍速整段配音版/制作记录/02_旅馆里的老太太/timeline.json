  "speed_factor": 1.0,
  "voice_playback_speed": 1.2,
  "sentence_timings": [
    {
      "index": 1,
      "text": "女孩住进旅馆，却不知道门外有人盯着她。",
      "role": "hook",
      "start": 0.0,
      "end": 3.1283973443678157
    },
    {
      "index": 2,
      "text": "她带着两个妹妹在房里玩，根本没有发现异常。",
      "role": "context",
      "start": 3.1283973443678157,
      "end": 6.142341127356322
    },
    {
      "index": 3,
      "text": "后来她肚子饿了，就独自爬上楼梯找吃的。",
      "role": "context",
      "start": 6.142341127356322,
      "end": 7.4900318125977
    },
    {
      "index": 4,
      "text": "可厨房的老太太，正抱着一块生肉不停地啃。",
      "role": "escalation",
      "start": 7.4900318125977,
      "end": 10.275068472827584
    },
    {
      "index": 5,
      "text": "老太太看见她，竟满嘴是血地笑了起来。",
      "role": "twist",
      "start": 10.275068472827584,
      "end": 13.06010513305747
    },
    {
      "index": 6,
      "text": "两个妹妹也跑了上来，吓得站在楼梯口不敢动。",
      "role": "escalation",
      "start": 13.06010513305747,
      "end": 14.602366872643678
    },
    {
      "index": 7,
      "text": "男人赶紧抱起女孩，带着三个孩子离开了这里。",
      "role": "payoff",
      "start": 14.602366872643678,
      "end": 17.501857094252873
    },
    {
      "index": 8,
      "text": "直到警车停在旅馆门口，她们才终于松了口气。",
      "role": "payoff",
      "start": 17.501857094252873,
      "end": 20.744708
    }
  ],
