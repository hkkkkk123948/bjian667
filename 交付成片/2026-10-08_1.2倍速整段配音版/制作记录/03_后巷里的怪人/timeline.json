  "sentence_timings": [
    {
      "index": 1,
      "text": "这三个女孩，被一个白发怪人盯上了。",
      "role": "hook",
      "start": 0.0,
      "end": 2.84
    },
    {
      "index": 2,
      "text": "她们赶紧往后巷跑，躲到了垃圾箱后面。",
      "role": "context",
      "start": 2.84,
      "end": 5.6
    },
    {
      "index": 3,
      "text": "女孩以为安全了，旁边的铁门却慢慢开了。",
      "role": "escalation",
      "start": 5.6,
      "end": 7.16
    },
    {
      "index": 4,
      "text": "一只满是尖指甲的手，从门缝里伸了进来。",
      "role": "escalation",
      "start": 7.16,
      "end": 9.88
    },
    {
      "index": 5,
      "text": "紧接着怪人探出了头，吓得她们再次逃跑。",
      "role": "escalation",
      "start": 9.88,
      "end": 12.92
    },
    {
      "index": 6,
      "text": "她们逃进仓库，可那个怪人又追到了门外。",
      "role": "context",
      "start": 12.92,
      "end": 14.638
    },
    {
      "index": 7,
      "text": "女孩正不知道怎么办，一个男人推门走了进来。",
      "role": "payoff",
      "start": 14.638,
      "end": 17.438
    },
    {
      "index": 8,
      "text": "他把女孩们救了出来，警察随后赶到调查。",
      "role": "payoff",
      "start": 17.438,
      "end": 20.7005
    }
  ],
