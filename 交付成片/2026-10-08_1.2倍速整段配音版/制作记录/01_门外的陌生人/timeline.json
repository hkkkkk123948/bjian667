  "voice_playback_speed": 1.2,
  "sentence_timings": [
    {
      "index": 1,
      "text": "女孩独自在家，门外突然来了两个陌生人。",
      "role": "hook",
      "start": 0.0,
      "end": 2.8996168335936785
    },
    {
      "index": 2,
      "text": "两个人衣服破烂，一直对着门里面笑。",
      "role": "hook",
      "start": 2.8996168335936785,
      "end": 5.379552283377745
    },
    {
      "index": 3,
      "text": "女孩不敢开门，只能隔着门跟他们说话。",
      "role": "context",
      "start": 5.379552283377745,
      "end": 6.905666406321787
    },
    {
      "index": 4,
      "text": "见对方一直不肯走，她就退到窗边往外看。",
      "role": "escalation",
      "start": 6.905666406321787,
      "end": 10.224964623725077
    },
    {
      "index": 5,
      "text": "她掀开百叶窗，才发现外面还有一个人。",
      "role": "context",
      "start": 10.224964623725077,
      "end": 13.239040016539558
    },
    {
      "index": 6,
      "text": "那个男人架着梯子，已经爬到了她家的房顶。",
      "role": "twist",
      "start": 13.239040016539558,
      "end": 14.656418508223835
    },
    {
      "index": 7,
      "text": "原来门口的两个人，是在帮他拖住女孩。",
      "role": "payoff",
      "start": 14.656418508223835,
      "end": 17.250812517228706
    },
    {
      "index": 8,
      "text": "女孩赶紧报警，直到警车赶来才躲过这一劫。",
      "role": "payoff",
      "start": 17.250812517228706,
      "end": 20.760875
    }
  ],
